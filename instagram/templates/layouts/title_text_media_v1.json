{
  "schema_version": "1.0",
  "template_id": "title_text_media_v1",
  "description": "Flat EirePolitic title/media layout with corner ornaments",
  "width": 1080,
  "height": 1350,
  "palette": "eirepolitic_dark",
  "background": {
    "type": "solid",
    "color": "{palette.background}"
  },
  "validation": {
    "max_top_whitespace_ratio": 0.08,
    "max_bottom_whitespace_ratio": 0.04,
    "min_occupied_height_ratio": 0.88
  },
  "elements": [
    {
      "id": "ornament_tl",
      "type": "image",
      "source": "instagram/templates/assets/corner_tl.png",
      "x": 0,
      "y": 0,
      "w": 155,
      "h": 155,
      "fit": "contain"
    },
    {
      "id": "ornament_tr",
      "type": "image",
      "source": "instagram/templates/assets/corner_tr.png",
      "x": 925,
      "y": 0,
      "w": 155,
      "h": 155,
      "fit": "contain"
    },
    {
      "id": "title",
      "type": "text",
      "placeholder": "slide_title",
      "x": 70,
      "y": 10,
      "w": 940,
      "h": 140,
      "style": {
        "font_family": "default_bold",
        "font_size": 56,
        "min_font_size": 36,
        "color": "{palette.text_primary}",
        "align": "center",
        "valign": "middle",
        "max_lines": 2,
        "shrink_to_fit": true
      },
      "validation": {
        "min_final_font_size": 36,
        "max_lines": 2,
        "allow_truncation": false,
        "allow_clipping": false
      }
    },
    {
      "id": "title_rule",
      "type": "rectangle",
      "x": 112,
      "y": 152,
      "w": 856,
      "h": 5,
      "fill": "{palette.accent}"
    },
    {
      "id": "main_media",
      "type": "image",
      "placeholder": "main_media",
      "x": 24,
      "y": 168,
      "w": 1032,
      "h": 1148,
      "fit": "contain",
      "background": "{palette.background}",
      "radius": 0,
      "validation": {
        "min_vertical_fill_ratio": 0.94,
        "min_area_fill_ratio": 0.88
      }
    },
    {
      "id": "ornament_bl",
      "type": "image",
      "source": "instagram/templates/assets/corner_bl.png",
      "x": 0,
      "y": 1195,
      "w": 155,
      "h": 155,
      "fit": "contain"
    },
    {
      "id": "ornament_br",
      "type": "image",
      "source": "instagram/templates/assets/corner_br.png",
      "x": 925,
      "y": 1195,
      "w": 155,
      "h": 155,
      "fit": "contain"
    }
  ]
}
