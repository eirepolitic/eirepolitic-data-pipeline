{
  "schema_version": "1.0",
  "template_id": "title_text_media_v1",
  "description": "Flat EirePolitic title/media layout with corner ornaments",
  "width": 1080,
  "height": 1350,
  "palette": "eirepolitic_dark",
  "background": {"type": "solid", "color": "{palette.background}"},
  "validation": {
    "max_top_whitespace_ratio": 0.08,
    "max_bottom_whitespace_ratio": 0.04,
    "min_occupied_height_ratio": 0.88
  },
  "elements": [
    {
      "id": "ornament_tl",
      "type": "text",
      "text": "❦",
      "x": 14,
      "y": 14,
      "w": 54,
      "h": 60,
      "style": {
        "font_family": "default_regular",
        "font_size": 46,
        "min_font_size": 46,
        "color": "{palette.text_primary}",
        "align": "left",
        "valign": "top",
        "max_lines": 1,
        "shrink_to_fit": false
      }
    },
    {
      "id": "ornament_tr",
      "type": "text",
      "text": "❧",
      "x": 1012,
      "y": 14,
      "w": 54,
      "h": 60,
      "style": {
        "font_family": "default_regular",
        "font_size": 46,
        "min_font_size": 46,
        "color": "{palette.text_primary}",
        "align": "right",
        "valign": "top",
        "max_lines": 1,
        "shrink_to_fit": false
      }
    },
    {
      "id": "title",
      "type": "text",
      "placeholder": "slide_title",
      "x": 70,
      "y": 10,
      "w": 940,
      "h": 140,
      "style": {
        "font_family": "default_bold",
        "font_size": 56,
        "min_font_size": 36,
        "color": "{palette.text_primary}",
        "align": "center",
        "valign": "middle",
        "max_lines": 2,
        "shrink_to_fit": true
      },
      "validation": {
        "min_final_font_size": 36,
        "max_lines": 2,
        "allow_truncation": false,
        "allow_clipping": false
      }
    },
    {
      "id": "title_rule",
      "type": "rectangle",
      "x": 112,
      "y": 152,
      "w": 856,
      "h": 5,
      "fill": "{palette.accent}"
    },
    {
      "id": "main_media",
      "type": "image",
      "placeholder": "main_media",
      "x": 24,
      "y": 168,
      "w": 1032,
      "h": 1148,
      "fit": "contain",
      "background": "{palette.background}",
      "radius": 0,
      "validation": {
        "min_vertical_fill_ratio": 0.94,
        "min_area_fill_ratio": 0.88
      }
    },
    {
      "id": "ornament_bl",
      "type": "text",
      "text": "❦",
      "x": 14,
      "y": 1280,
      "w": 54,
      "h": 56,
      "style": {
        "font_family": "default_regular",
        "font_size": 46,
        "min_font_size": 46,
        "color": "{palette.text_primary}",
        "align": "left",
        "valign": "bottom",
        "max_lines": 1,
        "shrink_to_fit": false
      }
    },
    {
      "id": "ornament_br",
      "type": "text",
      "text": "❧",
      "x": 1012,
      "y": 1280,
      "w": 54,
      "h": 56,
      "style": {
        "font_family": "default_regular",
        "font_size": 46,
        "min_font_size": 46,
        "color": "{palette.text_primary}",
        "align": "right",
        "valign": "bottom",
        "max_lines": 1,
        "shrink_to_fit": false
      }
    }
  ]
}
